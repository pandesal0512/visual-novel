            "(You have [player_hp] hp!)"
        else:
            $ player_hp = player_hp - 50
            "Ava attacks for 50 damage!"
            "(You have [player_hp] hp!)"
        
        $ renpy.pause(0.5)
        
        if player_hp <= 0:
            jump .butter_loses2
        
        # Enemy Turn - Butter's VARIED ATTACKS
        $ enemy_action = renpy.random.randint(1, 100)
        
        if enemy_action <= 100:
            $ attack_variant = renpy.random.randint(1, 3)
            
            hide chaos_idle
            hide chaos_attack
            hide chaos_hit
            hide butter_idle
            hide butter_attack1
            hide butter_attack2
            hide butter_attack3
            hide butter_hit
            hide ava_idle
            
            show chaos_hit at fight_left
            show ava_idle at Position(xalign=0.85, yalign=0.5)
            
            if attack_variant == 1:
                show butter_attack1 at fight_right
                show butter_attack1 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            elif attack_variant == 2:
                show butter_attack2 at fight_right
                show butter_attack2 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            else:
                show butter_attack3 at fight_right
                show butter_attack3 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            
            camera:
                ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            $ renpy.pause(1.0)
            
            hide butter_attack1
            hide butter_attack2
            hide butter_attack3
            hide chaos_hit
            show chaos_idle at fight_left
            show butter_idle at fight_right
            
            if attack_variant == 1:
                play sound "audio/sword-slash-and-swing-185432.mp3" volume 2.0
                if player_defending == "dodge":
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 5
                    "Defended, still took 5 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 10
                    "CHAOS" "owie"
                    "You took 10 damage"
                    "(You have [player_hp] hp!)"
                    
            elif attack_variant == 2:
                play sound "audio/sword-slash-and-swing-185432.mp3" volume 3.0
                if player_defending == "dodge":
                    "missed!"
                elif player_defending == True:
                    $ player_hp = player_hp - 5
                    "Defended, still took 5 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 10
                    "CHAOS" "owie"
                    "You took 10 damage"
                    "(You have [player_hp] hp!)"
                    
            else:
                play sound "audio/single-gunshot-62-hp-37188.mp3" volume 3.0
                if player_defending == "dodge":
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 10
                    "Defended, still took 10 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 15
                    "CHAOS" "owie"
                    "You took 15 damage"
                    "(You have [player_hp] hp!)"
        else:
            "[enemy_name]" "..."
        
        $ player_defending = False
        
        $ renpy.pause(0.5)
        
        jump .butter_battle_loop2
    
    # Victory Screen
    label .butter_wins2:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide chaos_idle
        hide chaos_attack
        hide chaos_hit
        hide butter_idle
        hide butter_attack1
        hide butter_attack2
        hide butter_attack3
        hide butter_hit
        hide ava_idle
        hide ava_attack
        hide ava_hit
        
        return
    
    # Defeat Screen
    label .butter_loses2:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide chaos_idle
        hide chaos_attack
        hide chaos_hit
        hide butter_idle
        hide butter_attack1
        hide butter_attack2
        hide butter_attack3
        hide butter_hit
        hide ava_idle
        hide ava_attack
        hide ava_hit
        
        
        menu:
            "Retry Battle":
                jump butter_ava_battle2
