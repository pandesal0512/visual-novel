transform fight_left:
    xpos 0.35
    ypos 0.5
    anchor (0.5, 0.5)
    zoom 1.0

transform fight_right:
    xpos 0.65
    ypos 0.5
    anchor (0.5, 0.5)
    zoom 1.0

# Image definitions for KARE
image kare_idle:
    "kare_idle.png"
    pause 1.0
    "kare_idle.png"
    pause 1.0
    repeat

image kare_attack:
    "kare_attack1.png"
    pause 0.3
    "kare_attack2.png"
    pause 0.7
    repeat

image kare_hit:
    "kare_hit.png"
    pause 1.0
    repeat

# Image definitions for NORMAL BUTTER
image normalbutter_idle:
    "butter_idle.png"
    pause 1.0
    "butter_idle.png"
    pause 1.0
    repeat

image normalbutter_attack:
    "butter_attack1.png"
    pause 0.3
    "butter_attack2.png"
    pause 0.7
    repeat

image normalbutter_hit:
    "butter_hit.png"
    pause 1.0
    repeat

# HP Bar Screen
screen hp_bars_1v1:
    vbox:
        spacing 20
        xalign 0.1
        yalign 0.0
        xmaximum 600
        text "You ([player_hp]/[player_max_hp]) ATK: [player_attack]"
        bar value player_hp range player_max_hp
    vbox:
        spacing 20
        xalign 0.9
        yalign 0.0
        xmaximum 600
        text "[enemy_name] ([enemy_hp]/[enemy_max_hp])"
        bar value enemy_hp range enemy_max_hp

label reset_camera:
    camera:
        perspective False
        gl_depth False
        matrixtransform ScaleMatrix(1.0, 1.0, 1.0)*OffsetMatrix(0.0, 0.0, 0.0)*RotateMatrix(0.0, 0.0, 0.0)
    return

# BUTTER BATTLE - FIXED VERSION
label simple_battle_graphics:
    # Initialize camera and scene
    camera:
        perspective False
        gl_depth False
    
    scene bg at truecenter
    show kare_idle at fight_left
    show normalbutter_idle at fight_right

    $ renpy.pause(0.5, hard='True')
    
    # Initialize Stats
    $ player_max_hp = 10
    $ player_hp = player_max_hp
    $ player_attack = 1
    $ player_defending = False
    $ enemy_name = "Butter"
    
    $ enemy_max_hp = 15
    $ enemy_hp = enemy_max_hp
    
    show screen hp_bars_1v1
    
    # Main Battle Loop
    label .battle_loop:
        if enemy_hp <= 0:
            jump .player_wins
        if player_hp <= 0:
            jump .player_loses
        
        # Player Turn
        menu:
            "Attack":
                # Hide all sprites first
                hide kare_idle
                hide kare_attack
                hide kare_hit
                hide normalbutter_idle
                hide normalbutter_attack
                hide normalbutter_hit
                
                # Show attack sprites
                show kare_attack at fight_left
                show normalbutter_hit at fight_right
                
                show kare_attack at fight_left:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.25
                
                camera:
                    ease 0.2 xpos 0.1 ypos -0.1 zoom 1.2
                    ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
                
                $ renpy.pause(1.0)
                
                # Return to idle
                hide kare_attack
                hide normalbutter_hit
                show kare_idle at fight_left
                show normalbutter_idle at fight_right
                
                $ enemy_hp -= player_attack
                play sound "punch-140236.mp3" volume 2.0
                
                "[player_attack] damage!"
                "Enemy has [enemy_hp] hp!"
                
                $ renpy.pause(0.5)
                
            "Defend":
                $ player_defending = True
                $ heal_amount = 2
                $ player_hp = min(player_hp + heal_amount, player_max_hp)
                "i will block this watch this"
                "You recovered [heal_amount] HP!"
                "(You have [player_hp] hp!)"
                $ renpy.pause(0.5)
                
            "Dodge":
                $ dodge_chance = renpy.random.randint(1, 100)
                if dodge_chance <= 50:
                    $ player_defending = "dodge"
                    $ player_attack += 1
                    "You prepare to dodge!"
                    "Your attack increased to [player_attack]!"
                else:
                    "You prepared to dodge but you trip and fell"
                $ renpy.pause(0.5)
        
        if enemy_hp <= 0:
            jump .player_wins
        
        # Enemy Turn
        $ enemy_action = renpy.random.randint(1, 100)
        
        if enemy_action <= 100:
            # Hide all sprites
            hide kare_idle
            hide kare_attack
            hide kare_hit
            hide normalbutter_idle
            hide normalbutter_attack
            hide normalbutter_hit
            
            # FIXED: Show normalbutter_attack instead of butter_attack
            show normalbutter_attack at fight_right
            show kare_hit at fight_left
            
            show normalbutter_attack at fight_right:
                ease 0.2 xpos 0.5
                ease 0.2 xpos 0.75
            
            camera:
                ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            $ renpy.pause(1.0)
            
            # Return to idle
            hide normalbutter_attack
            hide kare_hit
            show kare_idle at fight_left
            show normalbutter_idle at fight_right
            
            if player_defending == "dodge":
                "butter" "erm thats not fair"
                "You took no damage"
            elif player_defending == True:
                $ player_hp = player_hp - 0
                play sound "Berserk Clang Sound Effect.mp3" volume 2.0
                "kare" "haha i blocked"
                
                # Second attack
                hide kare_idle
                hide kare_attack
                hide kare_hit
                hide normalbutter_idle
                hide normalbutter_attack
                hide normalbutter_hit
                
                show normalbutter_attack at fight_right
                show kare_hit at fight_left
                
                show normalbutter_attack at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
                
                camera:
                    ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                    ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
                
                $ renpy.pause(1.0)
                
                hide normalbutter_attack
                hide kare_hit
                show kare_idle at fight_left
                show normalbutter_idle at fight_right
                
                $ player_hp = player_hp - 5
                play sound "Berserk Clang Sound Effect.mp3" volume 2.0
                "kare" "OWWWWW"
                "kare" "YOU ATTACKED TWICE THATS NOT FAIR!!"
                "butter" "whats not fair is you blocking"
                "You took 5 damage total!"
                "(You have [player_hp] hp!)"
            else:
                $ player_hp = player_hp - 2
                play sound "Berserk Clang Sound Effect.mp3" volume 2.0
                "kare" "OWWWWW"
                "You took 2 damage!"
                "(You have [player_hp] hp!)"
        else:
            "butter is recovering"
        
        $ player_defending = False
        
        $ renpy.pause(0.5)
        
        jump .battle_loop
    
    # Victory Screen
    label .player_wins:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide kare_idle
        hide kare_attack
        hide kare_hit
        hide normalbutter_idle
        hide normalbutter_attack
        hide normalbutter_hit
        
        with fade
        
        "yay win"
        
        return
    
    # Defeat Screen
    label .player_loses:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide kare_idle
        hide kare_attack
        hide kare_hit
        hide normalbutter_idle
        hide normalbutter_attack
        hide normalbutter_hit
        
        "You were defeated by Butter..."
        
        return

# ============================================
# LUMPI BATTLE (New Battle!) - UPDATED with restart feature
# ============================================

# Image definitions for LUMPI
image lumpi_idle:
    "lumpi_idle.png"
    pause 1.0
    "lumpi_idle.png"
    pause 1.0
    repeat

image lumpi_attack:
    "lumpi_attack1.png"
    pause 0.3
    "lumpi_attack2.png"
    pause 0.7
    repeat

image lumpi_hit:
    "lumpi_hit.png"
    pause 1.0
    repeat

image lumpi_wheelchair:
    "lumpi_wheelchair.png"
    pause 1.0
    repeat

label lumpi_battle:
    # Initialize camera and scene for lumpi
    camera:
        perspective False
        gl_depth False
    
    scene bg at truecenter
    show kare_idle at fight_left
    show lumpi_idle at fight_right

    $ renpy.pause(0.5, hard='True')
    
    # Initialize Stats - Lumpi is STRONGER!
    $ player_max_hp = 15
    $ player_hp = player_max_hp
    $ player_attack = 4  # NEW: Base attack for Lumpi battle
    $ player_defending = False
    $ enemy_name = "Lumpi"
    
    $ enemy_max_hp = 25 # Lumpi has more HP!
    $ enemy_hp = enemy_max_hp
    
    show screen hp_bars_1v1
    
    # Main Battle Loop
    label .lumpi_battle_loop:
        # Check win/lose first
        if enemy_hp <= 0:
            jump .lumpi_wins
        if player_hp <= 0:
            jump .lumpi_loses
        
        # Player Turn
        menu:
            "Attack":
                # Player attack animation
                hide kare_idle
                hide kare_attack
                hide kare_hit
                hide lumpi_idle
                hide lumpi_attack
                hide lumpi_hit
                
                show kare_attack at fight_left
                show lumpi_hit at fight_right
                
                show kare_attack at fight_left:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.25
                
                camera:
                    ease 0.2 xpos 0.1 ypos -0.1 zoom 1.2
                    ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
                
                $ renpy.pause(1.0)
                
                hide kare_attack
                hide lumpi_hit
                show kare_idle at fight_left
                show lumpi_idle at fight_right
                
                $ enemy_hp -= player_attack  # Use player_attack variable
                play sound "punch-140236.mp3" volume 2.0
                
                "[player_attack] damage!"
                "Lumpi has [enemy_hp] hp!"
                
                $ renpy.pause(0.5)
                
            "Defend":
                $ player_defending = True
                # NEW: Heal 3 HP when defending
                $ heal_amount = 3
                $ player_hp = min(player_hp + heal_amount, player_max_hp)
                "You brace yourself"
                "You recovered [heal_amount] HP!"
                "(You have [player_hp] hp!)"
                $ renpy.pause(0.5)
                
            "Dodge":
                $ dodge_chance = renpy.random.randint(1, 100)
                if dodge_chance <= 50:
                    $ player_defending = "dodge"
                    # NEW: Attack power up on successful dodge
                    $ player_attack += 2  # More power up in Lumpi battle
                    "dodge"
                    "Your attack increased to [player_attack]!"
                else:
                    "You prepared to dodge but you trip and fell"
                $ renpy.pause(0.5)

        
        
        # Check if enemy is still alive
        if enemy_hp <= 0:
            jump .lumpi_wins
        
        # Enemy Turn - Lumpi is more aggressive!
        $ enemy_action = renpy.random.randint(1, 100)
        
        if enemy_action <= 65:
            # Enemy attack animation
            hide kare_idle
            hide kare_attack
            hide kare_hit
            hide lumpi_idle
            hide lumpi_attack
            hide lumpi_hit
            
            show lumpi_attack at fight_right
            show kare_hit at fight_left
            
            show lumpi_attack at fight_right:
                ease 0.2 xpos 0.5
                ease 0.2 xpos 0.75
            
            camera:
                ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            $ renpy.pause(1.0)
            
            hide lumpi_attack
            hide kare_hit
            show kare_idle at fight_left
            show lumpi_idle at fight_right
            
            if player_defending == "dodge":
                play sound "sword-slash-and-swing-185432.mp3" volume 2.0
                "lumpi" "What?!"
                "no damage!"
            elif player_defending == True:
                $ player_hp = player_hp - 1
                play sound "sword-slash-and-swing-185432.mp3" volume 2.0
                "lumpi" "You think you can block my sword?!"
                "defended, still took 1 damage"
                "(You have [player_hp] hp!)"
            else:
                $ player_hp = player_hp - 2
                play sound "sword-slash-and-swing-185432.mp3" volume 2.0
                "lumpi" "HYAAA!!"
                "kare" "OWWWWW"
                "You took 3 damage"
                "(You have [player_hp] hp!)"
        else:
           
            "lumpi" "thats it im gonna get serious im locki- ow MY BACK!!!"
        
        # Reset defending status
        $ player_defending = False
        
        $ renpy.pause(0.5)
        
        # Loop back
        jump .lumpi_battle_loop
    
    # Victory Screen for Lumpi
    label .lumpi_wins:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        # Clear the fight scene
        hide kare_idle
        hide kare_attack
        hide kare_hit
        hide lumpi_idle
        hide lumpi_attack
        hide lumpi_hit

        
        return
    
    # Defeat Screen for Lumpi - NEW: Restart option
    label .lumpi_loses:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        # Clear the fight scene
        hide kare_idle
        hide kare_attack
        hide kare_hit
        hide lumpi_idle
        hide lumpi_attack
        hide lumpi_hit
        
    
        
        "You were defeated by Lumpi..."
        
        menu:
            "Retry Battle":
                jump lumpi_battle  # Restart the entire battle


