# VARIED ATTACK BATTLE TEMPLATE
# Each attack randomly picks from different sprites and sounds
# ============================================

# Image definitions - You need MULTIPLE attack sprites for variety
image newenemy_idle:
    "butter_serious_idle.png"
    pause 1.0
    repeat

# Attack variant 1
image newenemy_attack1:
    "butter_serious_attack1.png"
    pause 0.3
    "butter_serious_attack2.png"
    pause 0.7
    repeat

# Attack variant 2 (DIFFERENT animation)
image newenemy_attack2:
    "butter_serious_attack1.png"
    pause 2
    "butter_serious_attack2.png"
    pause 0.7
    repeat

# Attack variant 3 (DIFFERENT animation)
image newenemy_attack3:
    "butter_serious_altattack1.png"
    pause 2
    "butter_serious_altattack2.png"
    pause 0.7
    repeat

image newenemy_hit:
    "butter_serious_hurt.png"
    pause 1.0
    repeat

# VARIED ATTACK BATTLE
label newenemy_battle:
    # Initialize camera and scene
    camera:
        perspective False
        gl_depth False
    
    scene bg at truecenter
    show kare_idle at fight_left
    show newenemy_idle at fight_right

    $ renpy.pause(0.5, hard='True')
    
    # Initialize Stats
    $ player_max_hp = 50
    $ player_hp = player_max_hp
    $ player_attack = 1
    $ player_defending = False
    $ enemy_name = "butter"  # Change this
    
    $ enemy_max_hp = 100
    $ enemy_hp = enemy_max_hp
    
    show screen hp_bars_1v1
    
    # Main Battle Loop
    label .newenemy_battle_loop:
        if enemy_hp <= 0:
            jump .newenemy_wins
        if player_hp <= 0:
            jump .newenemy_loses
        
        # Player Turn
        menu:
            "Attack":
                hide kare_idle
                hide kare_attack
                hide kare_hit
                hide newenemy_idle
                hide newenemy_attack1
                hide newenemy_attack2
                hide newenemy_attack3
                hide newenemy_hit
                
                show kare_attack at fight_left
                show newenemy_hit at fight_right
                
                show kare_attack at fight_left:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.25
                
                camera:
                    ease 0.2 xpos 0.1 ypos -0.1 zoom 1.2
                    ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
                
                $ renpy.pause(1.0)
                
                hide kare_attack
                hide newenemy_hit
                show kare_idle at fight_left
                show newenemy_idle at fight_right
                
                $ enemy_hp -= player_attack
                play sound "punch-140236.mp3" volume 1.0
                
                "[player_attack] damage!"
                "[enemy_name] has [enemy_hp] hp!"
                
              
                
            "Defend":
                $ player_defending = True
                $ heal_amount = 4
                $ player_hp = min(player_hp + heal_amount, player_max_hp)
                "You brace yourself"
                "You recovered [heal_amount] HP!"
                "(You have [player_hp] hp!)"
                $ renpy.pause(0.5)
                
            "Dodge":
                $ dodge_chance = renpy.random.randint(1, 100)
                if dodge_chance <= 50:
                    $ player_defending = "dodge"
                    $ player_attack += 2
                    "Your attack increased to [player_attack]!"
                else:
                    "failed, she's too fast"
                $ renpy.pause(0.5)
        
        if enemy_hp <= 0:
            jump .newenemy_wins
        
        # Enemy Turn - VARIED ATTACKS!
        $ enemy_action = renpy.random.randint(1, 100)
        
        if enemy_action <= 100:  # 70% chance to attack
            # RANDOMLY CHOOSE WHICH ATTACK TO USE
            $ attack_variant = renpy.random.randint(1, 3)  # Pick 1, 2, or 3
            
            # Hide all sprites first
            hide kare_idle
            hide kare_attack
            hide kare_hit
            hide newenemy_idle
            hide newenemy_attack1
            hide newenemy_attack2
            hide newenemy_attack3
            hide newenemy_hit
            
            # Show the RANDOMLY SELECTED attack sprite
            if attack_variant == 1:
                show newenemy_attack1 at fight_right
                show kare_hit at fight_left
            elif attack_variant == 2:
                show newenemy_attack2 at fight_right
                show kare_hit at fight_left
            else:  # attack_variant == 3
                show newenemy_attack3 at fight_right
                show kare_hit at fight_left
            
            # Attack animation movement
            if attack_variant == 1:
                show newenemy_attack1 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            elif attack_variant == 2:
                show newenemy_attack2 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            else:
                show newenemy_attack3 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            
            camera:
                ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            $ renpy.pause(1.0)
            
            # Hide attack sprites and return to idle
            hide newenemy_attack1
            hide newenemy_attack2
            hide newenemy_attack3
            hide kare_hit
            show kare_idle at fight_left
            show newenemy_idle at fight_right
            
            # DIFFERENT DAMAGE AND SOUND FOR EACH ATTACK VARIANT
            if attack_variant == 1:
                # Attack variant 1 - Normal attack
                play sound "audio/sword-slash-and-swing-185432.mp3" volume 2.0
                if player_defending == "dodge":
                   
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 1
                   
                    "Defended, still took 1 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 4
                  
                    "kare" "nnhggh!"
                    "You took 3 damage"
                    "(You have [player_hp] hp!)"
                    
            elif attack_variant == 2:
                # Attack variant 2 - Sword slash
                play sound "audio/sword-slash-and-swing-185432.mp3" volume 3.0
                if player_defending == "dodge":
                    
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 2
                  
                    "Defended, still took 2 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 4
                
                    "kare" "nngh!!"
                    "You took 4 damage"
                    "(You have [player_hp] hp!)"
                    
            else:  # attack_variant == 3
                # Attack variant 3 - Heavy hit
                play sound "audio/single-gunshot-62-hp-37188.mp3" volume 3.0
                if player_defending == "dodge":
                
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 3
                 
                    "Defended, still took 3 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 6
                 
                    "kare" "nnghh"
                    "You took 6 damage"
                    "(You have [player_hp] hp!)"
        else:
            "[enemy_name]" "I'm preparing something..."
        
        $ player_defending = False
        
        $ renpy.pause(0.5)
        
        jump .newenemy_battle_loop
    
    # Victory Screen
    label .newenemy_wins:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide kare_idle
        hide kare_attack
        hide kare_hit
        hide newenemy_idle
        hide newenemy_attack1
        hide newenemy_attack2
        hide newenemy_attack3
        hide newenemy_hit
        
        
        return
    
    # Defeat Screen
    label .newenemy_loses:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide kare_idle
        hide kare_attack
        hide kare_hit
        hide newenemy_idle
        hide newenemy_attack1
        hide newenemy_attack2
        hide newenemy_attack3
        hide newenemy_hit
    
        
        menu:
            "Retry Battle":
                jump newenemy_battle


# ============================================
# HOW TO USE THIS TEMPLATE:
# ============================================
# 1. Create your enemy sprites:
#    - newenemy_idle.png
#    - newenemy_attack1_frame1.png, newenemy_attack1_frame2.png
#    - newenemy_attack2_frame1.png, newenemy_attack2_frame2.png
#    - newenemy_attack3_frame1.png, newenemy_attack3_frame2.png
#    - newenemy_hit.png
#
# 2. Replace "newenemy" with your enemy name throughout the code
#
# 3. Customize:
#    - Damage values for each attack variant
#    - Sound effects for each attack
#    - Enemy dialogue for each attack
#    - HP and stats
#
# 4. You can add MORE attack variants by:
#    - Adding more image definitions (attack4, attack5, etc.)
#    - Changing: $ attack_variant = renpy.random.randint(1, 5)  # for 5 variants
#    - Adding more elif statements for the new variants

# BATTLE WITH AVA SWITCHING SIDES
# ============================================

# Additional image definitions for Ava
image ava_idle:
    "ava_fight.png"
    pause 1.0
    repeat

image ava_attack:
    "ava_fight.png"
    pause 0.3
    "ava_fight.png"
    pause 0.7
    repeat

image ava_hit:
    "ava_fight.png"
    pause 1.0
    repeat

# Butter serious sprites for battle
image butter_idle:
    "butter_serious_idle.png"
    pause 1.0
    repeat

image butter_attack1:
    "butter_serious_attack1.png"
    pause 0.3
    "butter_serious_attack2.png"
    pause 0.7
    repeat

image butter_attack2:
    "butter_serious_attack1.png"
    pause 2
    "butter_serious_attack2.png"
    pause 0.7
    repeat

image butter_attack3:
    "butter_serious_altattack1.png"
    pause 2
    "butter_serious_altattack2.png"
    pause 0.7
    repeat

image butter_hit:
    "butter_serious_hurt.png"
    pause 1.0
    repeat

image chaos_idle:
    "chaos_idle.png"
    pause 0.3

image chaos_attack:
    "chaos_attack.png"
    pause 0.3
    "chaos_attack.png"
    pause 0.7

image chaos_hit:
    "chaos_hurt.png"
    pause 1.0


# BATTLE WITH AVA SWITCHING SIDES
# ============================================

# Additional image definitions for Ava
image ava_idle:
    "ava_fight.png"
    pause 1.0
    repeat

image ava_attack:
    "ava_fight.png"
    pause 0.3
    "ava_fight.png"
    pause 0.7
    repeat

image ava_hit:
    "ava_fight.png"
    pause 1.0
    repeat

# Butter serious sprites for battle
image butter_idle:
    "butter_serious_idle.png"
    pause 1.0
    repeat

image butter_attack1:
    "butter_serious_attack1.png"
    pause 0.3
    "butter_serious_attack2.png"
    pause 0.7
    repeat

image butter_attack2:
    "butter_serious_attack1.png"
    pause 2
    "butter_serious_attack2.png"
    pause 0.7
    repeat

image butter_attack3:
    "butter_serious_altattack1.png"
    pause 2
    "butter_serious_altattack2.png"
    pause 0.7
    repeat

image butter_hit:
    "butter_serious_hurt.png"
    pause 1.0
    repeat

# BATTLE WITH AVA
label butter_ava_battle:
    # Initialize camera and scene for battle
    camera:
        perspective False
        gl_depth False
    
    scene bg at truecenter
    show chaos_idle at fight_left
    show butter_idle at fight_right
    show ava_idle at Position(xalign=0.5, yalign=0.5)  # Ava in middle initially

    $ renpy.pause(0.5, hard='True')
    
    # Initialize Stats
    $ player_max_hp = 500
    $ player_hp = player_max_hp
    $ player_attack = 100
    $ player_defending = False
    $ enemy_name = "butter and ava"
    
    $ enemy_max_hp = 9999999999999
    $ enemy_hp = enemy_max_hp
    
    $ ava_on_player_side = True  # Track which side Ava is on
    $ ava_attacked_once = False  # Track if Ava has attacked
    
    show screen hp_bars_1v1
    
    # Main Battle Loop
    label .butter_battle_loop:
        if enemy_hp <= 0:
            jump .butter_wins
        if player_hp <= 0:
            jump .butter_loses
        
        # Player Turn
        menu:
            "Attack":
                hide chaos_idle
                hide chaos_attack
                hide chaos_hit
                hide butter_idle
                hide butter_attack1
                hide butter_attack2
                hide butter_attack3
                hide butter_hit
                
                show chaos_attack at fight_left
                show butter_hit at fight_right
                show ava_idle at Position(xalign=0.5, yalign=0.5)
                
                show chaos_attack at fight_left:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.25
                
                camera:
                    ease 0.2 xpos 0.1 ypos -0.1 zoom 1.2
                    ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
                
                $ renpy.pause(1.0)
                
                hide chaos_attack
                hide butter_hit
                show chaos_idle at fight_left
                show butter_idle at fight_right
                
                $ enemy_hp -= player_attack
                play sound "audio/glitch-sound-effect-450447.mp3" volume 2.0
                
                "[player_attack] damage!"
                "[enemy_name] has [enemy_hp] hp!"
                
                $ renpy.pause(0.5)
            "Defend":
                $ player_defending = True
                $ heal_amount = 4
                $ player_hp = min(player_hp + heal_amount, player_max_hp)
                show ava_idle at Position(xalign=0.5, yalign=0.5)
                "You brace yourself"
                "You recovered [heal_amount] HP!"
                "(You have [player_hp] hp!)"
                $ renpy.pause(0.5)
            "Dodge":
                $ dodge_chance = renpy.random.randint(1, 100)
                show ava_idle at Position(xalign=0.5, yalign=0.5)
                if dodge_chance <= 0:
                    $ player_defending = "dodge"
                    $ player_attack += 2
                    "Your attack increased to [player_attack]!"
                else:
                    "..."
                $ renpy.pause(0.5)
        
        if enemy_hp <= 0:
            jump .butter_wins
        
        # AVA'S TURN - She attacks the wrong person first!
        if not ava_attacked_once:
            $ ava_attacked_once = True
            
            # Ava attacks Butter (wrong target!)
            hide chaos_idle
            hide butter_idle
            hide ava_idle
            
            show chaos_idle at fight_left
            show butter_hit at fight_right
            show ava_attack at Position(xalign=0.5, yalign=0.5)
            
            show ava_attack at Position(xalign=0.5, yalign=0.5):
                ease 0.2 xpos 0.65
                ease 0.2 xpos 0.5
            
            camera:
                ease 0.2 xpos 0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            play sound "punch-140236.mp3" volume 2.0
            $ renpy.pause(1.0)
            
            $ enemy_hp -= 5  # Ava deals damage to Butter
            
            "Ava attacks Butter for 5 damage!"
            
            hide ava_attack
            hide butter_hit
            show butter_idle at fight_right
            show ava_idle at Position(xalign=0.5, yalign=0.5)
            
            "butter" "HOLD ON why are you attacking me?"
            "ava" "oh wait i forgot you are my ally"
            
            $ ava_on_player_side = False
            
            # Move Ava to Butter's side with animation
            show ava_idle at Position(xalign=0.5, yalign=0.5):
                ease 0.5 xalign 0.85
            
            $ renpy.pause(0.7)
            
        elif not ava_on_player_side:
            # Ava attacks on Butter's side (attacks Chaos)
            hide chaos_idle
            hide butter_idle
            hide ava_idle
            
            show chaos_hit at fight_left
            show butter_idle at fight_right
            show ava_attack at Position(xalign=0.85, yalign=0.5)
            
            show ava_attack at Position(xalign=0.85, yalign=0.5):
                ease 0.2 xpos 0.35
                ease 0.2 xpos 0.85
            
            camera:
                ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            play sound "audio/sword-slash-and-swing-185432.mp3" volume 2.0
            $ renpy.pause(1.0)
            
            hide ava_attack
            hide chaos_hit
            show chaos_idle at fight_left
            show ava_idle at Position(xalign=0.85, yalign=0.5)
            
            if player_defending == "dodge":
                "Ava's attack missed!"
            elif player_defending == True:
                $ player_hp = player_hp - 40
                "Defended against Ava! Still took 40 damage"
                "(You have [player_hp] hp!)"
            else:
                $ player_hp = player_hp - 60
                "Ava attacks for 60 damage!"
                "(You have [player_hp] hp!)"
            
            $ renpy.pause(0.5)
        
        if player_hp <= 0:
            jump .butter_loses
        
        # Enemy Turn - Butter's VARIED ATTACKS
        $ enemy_action = renpy.random.randint(1, 100)
        
        if enemy_action <= 100:
            $ attack_variant = renpy.random.randint(1, 3)
            
            hide chaos_idle
            hide chaos_attack
            hide chaos_hit
            hide butter_idle
            hide butter_attack1
            hide butter_attack2
            hide butter_attack3
            hide butter_hit
            hide ava_idle
            
            show chaos_hit at fight_left
            if ava_on_player_side:
                show ava_idle at Position(xalign=0.5, yalign=0.5)
            else:
                show ava_idle at Position(xalign=0.85, yalign=0.5)
            
            if attack_variant == 1:
                show butter_attack1 at fight_right
                show butter_attack1 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            elif attack_variant == 2:
                show butter_attack2 at fight_right
                show butter_attack2 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            else:
                show butter_attack3 at fight_right
                show butter_attack3 at fight_right:
                    ease 0.2 xpos 0.5
                    ease 0.2 xpos 0.75
            
            camera:
                ease 0.2 xpos -0.1 ypos -0.1 zoom 1.2
                ease 0.3 xpos 0.0 ypos 0.0 zoom 1.0
            
            $ renpy.pause(1.0)
            
            hide butter_attack1
            hide butter_attack2
            hide butter_attack3
            hide chaos_hit
            show chaos_idle at fight_left
            show butter_idle at fight_right
            
            if attack_variant == 1:
                play sound "audio/sword-slash-and-swing-185432.mp3" volume 2.0
                if player_defending == "dodge":
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 1
                    "Defended, still took 1 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 4
                    "CHAOS" "owie"
                    "You took 4 damage"
                    "(You have [player_hp] hp!)"
                    
            elif attack_variant == 2:
                play sound "audio/sword-slash-and-swing-185432.mp3" volume 3.0
                if player_defending == "dodge":
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 2
                    "Defended, still took 2 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 4
                    "CHAOS" "owie"
                    "You took 4 damage"
                    "(You have [player_hp] hp!)"
                    
            else:
                play sound "audio/single-gunshot-62-hp-37188.mp3" volume 3.0
                if player_defending == "dodge":
                    "No damage!"
                elif player_defending == True:
                    $ player_hp = player_hp - 3
                    "Defended, still took 3 damage"
                    "(You have [player_hp] hp!)"
                else:
                    $ player_hp = player_hp - 6
                    "CHAOS" "owie"
                    "You took 6 damage"
                    "(You have [player_hp] hp!)"
        else:
            "[enemy_name]" "I'm preparing something..."
        
        $ player_defending = False
        
        $ renpy.pause(0.5)
        
        jump .butter_battle_loop
    
    # Victory Screen
    label .butter_wins:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide chaos_idle
        hide chaos_attack
        hide chaos_hit
        hide butter_idle
        hide butter_attack1
        hide butter_attack2
        hide butter_attack3
        hide butter_hit
        hide ava_idle
        hide ava_attack
        hide ava_hit
        
   
        
        return
    
    # Defeat Screen
    label .butter_loses:
        $ renpy.pause(0.1)
        
        hide screen hp_bars_1v1
        call reset_camera
        
        hide chaos_idle
        hide chaos_attack
        hide chaos_hit
        hide butter_idle
        hide butter_attack1
        hide butter_attack2
        hide butter_attack3
        hide butter_hit
        hide ava_idle
        hide ava_attack
        hide ava_hit
      
        return



# BATTLE WITH AVA part 2 - FIXED
label butter_ava_battle2:
    # Initialize camera and scene for battle
    camera:
        perspective False
        gl_depth False
    
    scene bg at truecenter
    show chaos_idle at fight_left
