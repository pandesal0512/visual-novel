    $ player_hp = player_max_hp
    $ player_attack = 100
    $ player_defending = False
    $ enemy_name = "butter and ava"
    
    $ enemy_max_hp = 999
    $ enemy_hp = enemy_max_hp
    
    show screen hp_bars_1v1
    
    # Main Battle Loop
    label .butter_battle_loop2:
        if enemy_hp <= 0:
